# Loaded automatically by `vite build` (production mode).
# An environment variable set in the Vercel dashboard overrides this file, so the
# dashboard stays the place to change the backend per-deployment.
VITE_API_URL=https://csc-exam-portal-backend-delta.vercel.app

# Set VITE_GOOGLE_CLIENT_ID in the Vercel dashboard (Production scope) — it is the same
# "Web application" OAuth 2.0 Client ID as the backend's GOOGLE_CLIENT_ID. Left unset,
# the login page hides the Google button; email/password and Student ID sign-in still work.
