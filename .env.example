VITE_API_URL=http://localhost:8000

# Sign in with Google (OAuth 2.0).
# The SAME "Web application" OAuth 2.0 Client ID as the backend's GOOGLE_CLIENT_ID — the
# backend verifies that Google minted the id_token for this exact client.
# While it is blank the login page shows "Google sign-in is not configured" instead of the
# button; email/password and Student ID sign-in are unaffected either way.
VITE_GOOGLE_CLIENT_ID=
